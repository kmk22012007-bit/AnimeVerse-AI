# Django Core Settings
DJANGO_SECRET_KEY=animeverse-dev-insecure-key-2026-super-secret-key-12345
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Google Gemini AI Integration (Optional)
# If left empty, RYUK runs in intelligent offline fallback mode
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL_NAME=gemini-2.5-flash
GEMINI_API_KEY=

# Upstream Anime Metadata Providers
# Primary: Tenrai API v1 (official MAL REST mirror per https://api.tenrai.org/documentation)
# Secondary: AniList GraphQL fallback adapter
JIKAN_BASE_URL=https://api.tenrai.org/v1
